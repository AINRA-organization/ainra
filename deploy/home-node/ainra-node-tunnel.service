[Unit]
# D-117. Installed on the OPERATOR's machine by move-to-node.sh, which writes the node in place of @NODE@. The network
# runs on the node; this keeps it at its usual loopback ports here, so every local tool and drill works unchanged.
Description=AINRA test network on the home node, reachable here on its usual ports (ssh tunnel to @NODE@)
Documentation=https://github.com/JacobJandon/ainra/blob/main/deploy/home-node/README.md
After=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -L 127.0.0.1:4907:127.0.0.1:4907 -L 127.0.0.1:4911:127.0.0.1:4911 \
  -L 127.0.0.1:4991:127.0.0.1:4991 -L 127.0.0.1:8091:127.0.0.1:8091 @NODE@
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ainra-node-tunnel

[Install]
WantedBy=default.target
